{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.8/bin/python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/pre_tool.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.8/bin/python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/post_tool.py\"",
            "timeout": 65
          }
        ]
      }
    ]
  }
}
